# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: OpenAI model to use (default: gpt-5.6-luna)
# OPENAI_MODEL=gpt-5.6-luna

# Optional: OpenAI Speech-to-Text model to use (default: whisper-1)
# OPENAI_TRANSCRIPTION_MODEL=whisper-1

# --- Voice & Text-to-Speech (TTS) Settings ---
# Enable/disable voice replies globally (default: true)
# VOICE_REPLY_ENABLED=true

# Default to voice response when user sends a voice message (default: true)
# DEFAULT_VOICE_REPLY_TO_VOICE_MESSAGE=true

# OpenAI Text-to-Speech model to use (default: gpt-4o-mini-tts)
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# OpenAI Text-to-Speech voice to use (default: marin)
# OPENAI_TTS_VOICE=marin

# Optional speech instructions for TTS tone and pacing
# OPENAI_TTS_INSTRUCTIONS=Speak naturally, warmly, and clearly at a moderate pace suitable for a language learner.

# PostgreSQL database connection URL
DATABASE_URL=postgresql://

# --- AI Context Management ---

# Enable/disable input context budget management (default: true)
# AI_SHORT_CONTEXT_ENABLED=true

# Maximum allowed input tokens before truncation (default: 272000)
# AI_SHORT_CONTEXT_MAX_INPUT_TOKENS=272000

# Safety margin subtracted from max to account for estimation variance (default: 5000)
# AI_SHORT_CONTEXT_SAFETY_MARGIN_TOKENS=5000

# Context reduction strategy (default: truncate_oldest)
# AI_SHORT_CONTEXT_STRATEGY=truncate_oldest

# --- Dynamic Language Level Assessment ---

# Enable/disable dynamic language level assessment (default: true)
# LANGUAGE_LEVEL_ASSESSMENT_ENABLED=true

# Minimum confidence required to propose a level update (default: 0.75)
# LANGUAGE_LEVEL_MIN_CONFIDENCE=0.75

# Minimum number of evidence items required before level update proposal (default: 5)
# LANGUAGE_LEVEL_MIN_EVIDENCE=5
