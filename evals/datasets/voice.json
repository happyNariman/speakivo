          "confirm_language_level"
        ]
      },
      "sideEffects": [
        {
          "type": "mistake_recorded",
          "details": {
            "category": "grammar"
          }
        }
      ],
      "response": {
        "nonEmpty": true,
        "containsSubstrings": ["went"],
        "noRawIds": true,
        "modality": "voice"
      }
    }
  },
