    "name": "Voice message with grammar error: Past Simple 'go' instead of 'went'",
    "category": "voice",
    "input": "Yesterday I go to the cinema with my friends.",
    "inputModality": "voice",
    "user": {
      "languageCode": "en",
      "nativeLanguageCode": "ru",
      "level": "A2"
    },
    "expectations": {
      "toolCalls": {
        "required": [
          {
            "tool": "record_learning_mistake",
            "count": 1
