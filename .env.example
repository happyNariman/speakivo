# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: OpenAI model to use (default: gpt-5.6-luna)
# OPENAI_MODEL=gpt-5.6-luna

# PostgreSQL database connection URL
DATABASE_URL=postgresql://

# --- AI Context Management (Stage 2) ---

# Enable/disable input context budget management (default: true)
# AI_SHORT_CONTEXT_ENABLED=true

# Maximum allowed input tokens before truncation (default: 272000)
# AI_SHORT_CONTEXT_MAX_INPUT_TOKENS=272000

# Safety margin subtracted from max to account for estimation variance (default: 5000)
# AI_SHORT_CONTEXT_SAFETY_MARGIN_TOKENS=5000

# Context reduction strategy (default: truncate_oldest)
# AI_SHORT_CONTEXT_STRATEGY=truncate_oldest
